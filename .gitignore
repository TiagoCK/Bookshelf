# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files (database URLs, API keys — never commit these)
.env
.env*.local
.env.swp
.env*.local*
# vercel
.vercel

#images for now
/images

# diary scans — private content, served from disk, never committed
/images

# editor swap files (a .env.local.swp holds your env file's contents)
*.swp
*.swo
*~

# generated by scripts/add-pages.mjs; mirrors the gitignored images/
/src/lib/manifest.generated.json

# Tesseract language data, ~15 MB, fetched on first run. The script caches it in
# the temp directory; this catches it if that ever changes.
*.traineddata
